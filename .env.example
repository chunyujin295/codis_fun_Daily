# Runtime paths
DATA_DIR=./data
DATABASE_PATH=./data/daily-knowledge.db

# Set these only for first boot. The server stores slow password hashes.
ADMIN_PASSWORD=

# Generate 32 random bytes and encode them as Base64.
TTS_MASTER_KEY=

# Public routing
PUBLIC_BASE_URL=https://codis.fun/Daily
TRUSTED_PROXY_CIDRS=127.0.0.1/32
